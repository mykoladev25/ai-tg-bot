# ==================== TELEGRAM ====================
# Отримайте з @BotFather: https://t.me/botfather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== AI SERVICES ====================
# Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Midjourney API: https://www.midjourneyapi.io
MIDJOURNEY_API_KEY=YOUR_MIDJOURNEY_KEY
MIDJOURNEY_API_URL=https://api.midjourneyapi.io/v1

# Replicate API: https://replicate.com
REPLICATE_API_KEY=YOUR_REPLICATE_KEY

# RunwayML API: https://www.runwayml.com
RUNWAY_API_KEY=YOUR_RUNWAY_KEY

# GROQ API: https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_KEY

# Google Gemini: https://ai.google.dev
GEMINI_API_KEY=YOUR_GEMINI_KEY

# ==================== ADMIN ====================
# Ваш Telegram ID для отримання помилок
ADMIN_TELEGRAM_ID=YOUR_ADMIN_ID

# ==================== DATABASE ====================
# MongoDB URI
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ==================== ENVIRONMENT ====================
# production або development
NODE_ENV=production

# Чи відправляти broadcast повідомлення при старті
SEND_STARTUP_BROADCAST=false

# ==================== STRIPE ====================
# Отримайте з https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ==================== SERVER ====================
# Порт серверу
PORT=5500

# URL додатку (для редиректів)
# Локально: http://127.0.0.1:5500
# Production: https://yourdomain.com
APP_URL=https://neurolab.fun

# Ім'я Telegram бота (без @)
BOT_USERNAME=your_bot_username

# ==================== LEGAL ====================
# Посилання на угоду користувача
TERMS_OF_SERVICE_URL=https://yourdomain.com/terms

# Посилання на політику приватності
PRIVACY_POLICY_URL=https://yourdomain.com/privacy

# ==================== LIQPAY ====================
# Отримайте з https://www.liqpay.ua/admin/business
# Для SANDBOX (тестування):
# LIQPAY_PUBLIC_KEY=sandbox_XXXXX
# LIQPAY_PRIVATE_KEY=sandbox_XXXXX

# Для PRODUCTION:
LIQPAY_PUBLIC_KEY=pk_live_YOUR_PRODUCTION_KEY
LIQPAY_PRIVATE_KEY=sk_live_YOUR_PRODUCTION_KEY

# API URL LiqPay
LIQPAY_SERVER_URL=https://www.liqpay.ua/api/3

